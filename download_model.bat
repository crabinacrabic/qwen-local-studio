@echo off
chcp 65001 > nul
title Ollama Model Downloader
color 0A

echo ========================================================
echo         Загрузчик моделей Qwen в Ollama
echo ========================================================
echo.
echo Рекомендуемые модели под твою RX 6600 (8 GB VRAM):
echo   1. qwen3:8b         (~5.2 GB - Главный умный флагман с рассуждениями)
echo   2. qwen2.5-coder:7b (~4.7 GB - Специализированный эталон для кода)
echo   3. qwen3:14b        (~9.0 GB - Тяжелая модель с гибридной памятью)
echo.
echo По умолчанию выбрана: qwen3:8b
set /p model="Введи имя модели (или нажми Enter для qwen3:8b): "

if "%model%"=="" set model=qwen3:8b

echo.
echo --------------------------------------------------------
echo Начинаем загрузку: %model%
echo Ниже отображается шкала процентов и скорость в реальном времени:
echo --------------------------------------------------------
echo.

"%LOCALAPPDATA%\Programs\Ollama\ollama.exe" pull %model%

echo.
echo ========================================================
echo Готово! Модель %model% успешно скачана и установлена.
echo Теперь она сразу доступна в твоем чате!
echo ========================================================
echo.
pause
